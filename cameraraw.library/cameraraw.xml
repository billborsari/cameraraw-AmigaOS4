<?xml version="1.0" encoding="iso-8859-1"?>
<!DOCTYPE library SYSTEM "library.dtd">
<library name="cameraraw" basename="CameraRawBase" basetype="Library" openname="cameraraw.library">
	<include>libraries/cameraraw.h</include>
	<interface name="main" version="1.0" struct="CameraRawIFace" prefix="_CameraRaw_" asmprefix="ICameraRaw" global="ICameraRaw">
		<method name="Obtain" result="uint32"/>
		<method name="Release" result="uint32"/>
		<method name="Expunge" result="void" status="unimplemented"/>
		<method name="Clone" result="struct Interface *" status="unimplemented"/>
		<method name="CameraRaw_Init" result="APTR">
			<arg name="flags" type="uint32"/>
		</method>
		<method name="CameraRaw_OpenFile" result="int">
			<arg name="handle" type="APTR"/>
			<arg name="filename" type="const char *"/>
		</method>
		<method name="CameraRaw_Unpack" result="int">
			<arg name="handle" type="APTR"/>
		</method>
		<method name="CameraRaw_Process" result="int">
			<arg name="handle" type="APTR"/>
		</method>
